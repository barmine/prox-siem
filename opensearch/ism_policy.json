{
  "policy": {
    "description": "proxmox-logs-*: hot for 30 days, then delete.",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          { "state_name": "delete", "conditions": { "min_index_age": "30d" } }
        ]
      },
      {
        "name": "delete",
        "actions": [{ "delete": {} }],
        "transitions": []
      }
    ],
    "ism_template": [
      { "index_patterns": ["proxmox-logs-*"], "priority": 100 }
    ]
  }
}
