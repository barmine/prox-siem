{
  "policy": {
    "description": "proxmox-logs-*: hot for ${HOT_RETENTION_DAYS} days, then delete.",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          { "state_name": "delete", "conditions": { "min_index_age": "${HOT_RETENTION_DAYS}d" } }
        ]
      },
      {
        "name": "delete",
        "actions": [{ "delete": {} }],
        "transitions": []
      }
    ],
    "ism_template": [
      { "index_patterns": ["proxmox-logs-*"], "priority": 100 }
    ]
  }
}
