# Copied to /etc/default/fluent-bit on each log-source host by install.sh.
# FB_HOSTNAME is set automatically by the systemd unit (%H) -- don't set it here.

# LAN IP for the PVE node and local PBS instance; Tailscale IP for the
# remote VPS PBS instance. Set by install.sh from its --siem-host argument.
SIEM_OPENSEARCH_HOST=
SIEM_OPENSEARCH_PORT=9200
