OPENSEARCH_URL=http://localhost:9200
INDEX_PREFIX=proxmox-logs
SHARED_SECRET=change-me-to-a-long-random-string
# Must be one of dashboard.py's PAGE_SIZE_OPTIONS: 25, 50, or 100.
DASHBOARD_PAGE_SIZE=50

# Phase 3: detection/scoring layer. Defaults shown -- uncomment to override.
# RULES_PATH=/home/carmine/Projects/proxsiem/rules.yaml
# CLUSTERS_INDEX=proxmox-clusters
# DEDUP_LOOKBACK_MINUTES=30
# DEDUP_RETENTION_MINUTES=10080
# DEDUP_MAX_DOCS=5000
# RANKING_HALF_LIFE_MINUTES=60
# RANKING_ACTIVE_WINDOW_HOURS=24
# RANKING_DEFAULT_LIMIT=50

# Phase 4: pipeline health thresholds. Defaults shown -- uncomment to override.
# PIPELINE_HEARTBEAT_STALE_MINUTES=5
# PIPELINE_WEBHOOK_STALE_HOURS=48

# Phase 4: outbound alerting -- disabled unless ALERT_ENABLED=true AND
# ALERT_WEBHOOK_URL is set. See docs/phase4-operations.md.
# ALERT_ENABLED=false
# ALERT_TARGET_TYPE=ntfy
# ALERT_WEBHOOK_URL=

# Phase 4: ISM hot-tier retention (days). NOT read by the Flask app --
# this is a setup.sh-time-only variable, set it in your shell before
# running ./opensearch/setup.sh, not here.
# ISM_HOT_RETENTION_DAYS=30
